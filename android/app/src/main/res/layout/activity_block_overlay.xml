<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#020617"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <!-- Top FocusGuard Badge -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#1e293b"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🛡️ FocusGuard Shield"
                android:textColor="#38bdf8"
                android:textStyle="bold"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Main Shield / Lock Icon Frame -->
        <FrameLayout
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:background="#0f172a"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="🔒"
                android:textSize="44sp" />
        </FrameLayout>

        <!-- Primary Heading -->
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Stay Focused"
            android:textColor="#ffffff"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/tv_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="This app is blocked during your active Focus Mode."
            android:textColor="#94a3b8"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- Blocked App Info Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#0f172a"
            android:padding="16dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BLOCKED APPLICATION"
                android:textColor="#64748b"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tv_blocked_app_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Distracting Application"
                android:textColor="#ffffff"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="2dp" />

            <TextView
                android:id="@+id/tv_blocked_pkg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="com.example.app"
                android:textColor="#64748b"
                android:textSize="11sp"
                android:fontFamily="monospace" />
        </LinearLayout>

        <!-- Remaining Focus Time Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#172554"
            android:padding="18dp"
            android:layout_marginBottom="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="REMAINING FOCUS TIME"
                android:textColor="#93c5fd"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tv_remaining_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="24:59"
                android:textColor="#ffffff"
                android:textSize="36sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />
        </LinearLayout>

        <!-- Primary Action Button: Back to FocusGuard -->
        <Button
            android:id="@+id/btn_return_focusguard"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Back to FocusGuard"
            android:textColor="#ffffff"
            android:textSize="15sp"
            android:textStyle="bold"
            android:backgroundTint="#2563eb"
            android:layout_marginBottom="12dp" />

        <!-- Secondary Action Button: Home Screen -->
        <Button
            android:id="@+id/btn_go_home"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Go to Home Screen"
            android:textColor="#cbd5e1"
            android:textSize="14sp"
            android:backgroundTint="#1e293b" />

    </LinearLayout>
</ScrollView>
